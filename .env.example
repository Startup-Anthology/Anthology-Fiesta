# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/fiesta

# Server
PORT=8080

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=<random-256-bit-hex>

# Integrations — AES-256-GCM key for encrypting OAuth tokens at rest
INTEGRATION_ENCRYPTION_KEY=<random-256-bit-hex>

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,exp://localhost:8081

# OpenAI
OPENAI_API_KEY=sk-...
# Optional: override base URL (e.g. Azure OpenAI, local proxy)
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: override model names
# AI_MAIN_MODEL=gpt-4o
# AI_ROUTER_MODEL=gpt-4o-mini

# S3-compatible storage (works with AWS S3, Cloudflare R2, MinIO, Supabase Storage)
S3_ENDPOINT=https://...
S3_BUCKET=fiesta-files
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...
S3_REGION=auto

# Google OAuth (for Gmail + Google Calendar integration)
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...

# Microsoft OAuth (for Outlook Mail + Outlook Calendar integration)
MICROSOFT_CLIENT_ID=...
MICROSOFT_CLIENT_SECRET=...

# Notion OAuth
NOTION_CLIENT_ID=...
NOTION_CLIENT_SECRET=...

# Slack OAuth (for Slack notifications + daily digest)
SLACK_CLIENT_ID=...
SLACK_CLIENT_SECRET=...

# Optional: Horizon CRM integration
# CRM_API_KEY=...
# HORIZON_BASE_URL=https://...

# Horizon CRM webhooks
# HORIZON_WEBHOOK_SECRET=...
# HORIZON_DEFAULT_USER_ID=...

# Server base URL (used for OAuth callbacks and Gmail webhook audience)
# API_BASE_URL=http://localhost:8080

# Gmail webhook audience (overrides API_BASE_URL for PubSub verification)
# GMAIL_WEBHOOK_AUDIENCE=...

# Post-OAuth redirect URL
# INTEGRATION_SUCCESS_REDIRECT=/

# StartupAnthology.com (SA) inbound webhook
# SA_WEBHOOK_SECRET: shared secret — horizon-marketing sends this as x-api-key header
# SA_DEFAULT_USER_ID: UUID of the Fiesta user that owns SA-sourced leads (required)
# SA_CRM_API_KEY=...    # Optional: enables pull sync from SA_BASE_URL
# SA_BASE_URL=...       # Optional: SA API base URL for pull sync (Cloudflare WAF bypass required)
