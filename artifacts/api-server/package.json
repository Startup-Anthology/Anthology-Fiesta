{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run lint && NODE_ENV=development node --env-file=../../.env --import tsx/esm ./src/index.ts",
    "dev:fast": "NODE_ENV=development node --env-file=../../.env --import tsx/esm ./src/index.ts",
    "build": "tsx ./build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "check": "pnpm run lint",
    "check:full": "pnpm -w run typecheck:libs && pnpm run typecheck && pnpm run lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.840.0",
    "@aws-sdk/s3-request-presigner": "^3.840.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^8.3.1",
    "google-auth-library": "^10.6.1",
    "googleapis": "148.0.0",
    "jose": "^5.10.0",
    "multer": "^2.1.1",
    "node-cron": "3.0.3",
    "otpauth": "^9.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "catalog:",
    "@types/node-cron": "3.0.11",
    "@types/supertest": "^7.2.0",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.3",
    "openai": "^6.27.0",
    "supertest": "^7.2.2",
    "tsx": "catalog:",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.2"
  }
}
